{% macro scorecard_table(rows, show_reason=false) -%}
<table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:13px;">
  <tr style="background-color:#1f2d3d;color:#ffffff;">
    <th align="left" width="9%" style="padding:8px 10px;">Ticker</th>
    <th align="right" width="7%" style="padding:8px 10px;">Comp</th>
    <th align="right" width="7%" style="padding:8px 10px;">R40 FCF</th>
    <th align="right" width="7%" style="padding:8px 10px;">R40 EBITDA</th>
    <th align="right" width="7%" style="padding:8px 10px;">R40 SBC-adj</th>
    <th align="right" width="6%" style="padding:8px 10px;">Growth</th>
    <th align="right" width="6%" style="padding:8px 10px;">FCF mgn</th>
    <th align="left" width="14%" style="padding:8px 10px;">Trend</th>
    <th align="left" width="9%" style="padding:8px 10px;">Valuation</th>
    <th align="left" width="28%" style="padding:8px 10px;">{{ "Why weakest" if show_reason else "Flags" }}</th>
  </tr>
  {% for sc in rows %}
  <tr style="background-color:{{ '#ffffff' if loop.index is odd else '#f2f5f8' }};border-bottom:1px solid #dde3e9;">
    <td style="padding:7px 10px;white-space:nowrap;"><span style="font-weight:bold;">{{ sc.ticker }}</span>{% if sc.company_name %}<br><span style="font-size:11px;color:#66727f;">{{ sc.company_name }}</span>{% endif %}</td>
    <td align="right" style="padding:7px 10px;white-space:nowrap;"><span style="font-weight:bold;">{{ sc.composite|score }}</span><br><span style="font-size:10px;color:#66727f;">F {{ sc.score|score }} · T {{ sc.technical_score|score }}</span></td>
    <td align="right" style="padding:7px 10px;{% if sc.r40_fcf is not none and sc.r40_fcf >= 0.40 %}font-weight:bold;{% endif %}">{{ sc.r40_fcf|pts }}</td>
    <td align="right" style="padding:7px 10px;{% if sc.r40_ebitda is not none and sc.r40_ebitda >= 0.40 %}font-weight:bold;{% endif %}">{{ sc.r40_ebitda|pts }}</td>
    <td align="right" style="padding:7px 10px;{% if sc.r40_sbc_adj is not none and sc.r40_sbc_adj >= 0.40 %}font-weight:bold;{% endif %}">{{ sc.r40_sbc_adj|pts }}</td>
    <td align="right" style="padding:7px 10px;">{{ sc.growth|pct }}</td>
    <td align="right" style="padding:7px 10px;">{{ sc.fcf_margin|pct }}</td>
    <td style="padding:7px 10px;white-space:nowrap;">{{ trend_arrows.get(sc.tech.trend_state, "n/a") if sc.tech else "n/a" }}{% if spark_src.get(sc.ticker) %}<br><img src="{{ spark_src[sc.ticker] }}" width="120" height="30" alt="1y price" style="display:block;border:0;">{% endif %}</td>
    <td style="padding:7px 10px;">{{ sc.valuation or "n/a" }}</td>
    {% if show_reason %}
    <td style="padding:7px 10px;color:#8a2a2a;">{{ sc.reason or "n/a" }}{% if sc.flags %}<br><span style="font-size:11px;color:#8a6d00;">{{ flag_labels(sc)|join(" · ") }}</span>{% endif %}</td>
    {% else %}
    <td style="padding:7px 10px;color:#8a6d00;">{{ flag_labels(sc)|join(" · ") or "none" }}</td>
    {% endif %}
  </tr>
  {% endfor %}
</table>
{%- endmacro %}
<table cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#eef1f4;padding:0;margin:0;">
  <tr><td align="center" style="padding:20px 8px;">
    <table cellpadding="0" cellspacing="0" border="0" width="920" style="width:920px;max-width:98%;background-color:#ffffff;border:1px solid #d8dee5;">
      <tr><td style="padding:18px 24px;border-bottom:3px solid #1f2d3d;font-family:Arial,Helvetica,sans-serif;">
        <span style="font-size:20px;font-weight:bold;color:#1f2d3d;">Ticker Sentinel</span>
        <span style="font-size:13px;color:#66727f;">&nbsp;&nbsp;{{ report_date }} · {{ run_type }} run · {{ n_total }} tickers · watchlist median R40 (FCF): {{ median_r40 }}</span>
      </td></tr>
      {% if benchmark_line %}
      <tr><td style="padding:10px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#33404d;background-color:#f7f9fb;">{{ benchmark_line }}</td></tr>
      {% endif %}
      {% if notes %}
      <tr><td style="padding:10px 24px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#8a6d00;background-color:#fff8e1;">
        <b>Data notes:</b>
        {% for note in notes %}<br>• {{ note }}{% endfor %}
      </td></tr>
      {% endif %}
      {% if change_set %}
      <tr><td style="padding:18px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">What changed today{% if change_set.prior_date and not change_set.quiet %} <span style="font-size:12px;font-weight:normal;color:#66727f;">(vs {{ change_set.prior_date }})</span>{% endif %}</td></tr>
      {% if change_set.prior_date is none %}
      <tr><td style="padding:0 24px 12px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#66727f;">No prior run state yet; change detection starts with the next run.</td></tr>
      {% elif change_set.quiet %}
      <tr><td style="padding:0 24px 12px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#66727f;">Quiet day: no material changes vs the prior run ({{ change_set.prior_date }}).</td></tr>
      {% else %}
      <tr><td style="padding:0 24px 12px;">
        <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:13px;">
          {% for c in change_set.changes %}{% set arrow = change_arrows.get(c.direction, change_arrows["info"]) %}
          <tr style="background-color:{{ '#ffffff' if loop.index is odd else '#f2f5f8' }};border-bottom:1px solid #dde3e9;">
            <td width="80" style="padding:6px 10px;font-weight:bold;white-space:nowrap;">{{ c.ticker }}</td>
            <td width="30" align="center" style="padding:6px 4px;color:{{ arrow[1] }};font-weight:bold;">{{ arrow[0] }}</td>
            <td style="padding:6px 10px;color:#33404d;">{{ c.detail }}</td>
          </tr>
          {% endfor %}
        </table>
      </td></tr>
      {% endif %}
      {% endif %}
      {% if deterioration %}
      <tr><td style="padding:12px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#8a2a2a;">Deterioration watch <span style="font-size:12px;font-weight:normal;color:#66727f;">(multiple negative signals{% if week_span %}; week window = {{ week_span }} runs{% endif %})</span></td></tr>
      <tr><td style="padding:0 24px 12px;">
        <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:13px;">
          <tr style="background-color:#8a2a2a;color:#ffffff;">
            <th align="left" width="9%" style="padding:8px 10px;">Ticker</th>
            <th align="right" width="8%" style="padding:8px 10px;">Comp</th>
            <th align="right" width="9%" style="padding:8px 10px;">1 run</th>
            <th align="right" width="9%" style="padding:8px 10px;">Week</th>
            <th align="left" width="65%" style="padding:8px 10px;">Why</th>
          </tr>
          {% for row in deterioration %}
          <tr style="background-color:{{ '#fdf6f6' if loop.index is odd else '#f9eded' }};border-bottom:1px solid #e5c9c9;">
            <td style="padding:7px 10px;font-weight:bold;">{{ row.ticker }}</td>
            <td align="right" style="padding:7px 10px;">{{ row.composite|score }}</td>
            <td align="right" style="padding:7px 10px;color:{{ '#c0392b' if row.delta_1run is not none and row.delta_1run < 0 else '#33404d' }};">{{ row.delta_1run|sdelta }}</td>
            <td align="right" style="padding:7px 10px;color:{{ '#c0392b' if row.delta_week is not none and row.delta_week < 0 else '#33404d' }};">{{ row.delta_week|sdelta }}</td>
            <td style="padding:7px 10px;color:#8a2a2a;">{{ row.reasons|join("; ") }}</td>
          </tr>
          {% endfor %}
        </table>
      </td></tr>
      {% endif %}
      <tr><td style="padding:{{ '12px' if change_set else '18px' }} 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">Strong performers</td></tr>
      <tr><td style="padding:0 24px 12px;">
        {% if strongest %}{{ scorecard_table(strongest) }}{% else %}<span style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#66727f;">No scorable tickers this run.</span>{% endif %}
      </td></tr>
      <tr><td style="padding:12px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">Weak performers</td></tr>
      <tr><td style="padding:0 24px 12px;">
        {% if weakest %}{{ scorecard_table(weakest, show_reason=true) }}{% else %}<span style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#66727f;">Not enough scored names this run to split out a weak-performers table.</span>{% endif %}
      </td></tr>
      {% if movers %}
      <tr><td style="padding:12px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">Movers &amp; alerts</td></tr>
      <tr><td style="padding:0 24px 12px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#33404d;line-height:1.7;">
        {% for m in movers %}• {{ m }}<br>{% endfor %}
      </td></tr>
      {% endif %}
      {% if news_sections %}
      <tr><td style="padding:12px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">What mattered today <span style="font-size:12px;font-weight:normal;color:#66727f;">(news matched to your names)</span></td></tr>
      {% for sec in news_sections %}
      {% if sec.label %}
      <tr><td style="padding:{{ '2px' if loop.first else '14px' }} 24px 4px;font-family:Arial,Helvetica,sans-serif;">
        <span style="display:inline-block;background-color:#1f2d3d;color:#ffffff;padding:2px 10px;font-size:11px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">{{ sec.label }}</span>
      </td></tr>
      {% endif %}
      <tr><td style="padding:0 24px 12px;{% if not loop.last %}border-bottom:1px solid #eef1f4;{% endif %}">{{ sec.html|safe }}</td></tr>
      {% endfor %}
      {% endif %}
      {% if signal_rows %}
      <tr><td style="padding:12px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">Between-quarter signals <span style="font-size:12px;font-weight:normal;color:#66727f;">(weekly-or-faster; informational, not scored)</span></td></tr>
      <tr><td style="padding:0 24px 12px;">
        <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:13px;">
          <tr style="background-color:#33404d;color:#ffffff;">
            <th align="left" style="padding:8px 10px;">Ticker</th>
            <th align="center" style="padding:8px 10px;">Est. revisions 30d</th>
            <th align="center" style="padding:8px 10px;">Recs (B/H/S)</th>
            <th align="right" style="padding:8px 10px;">Short % float</th>
            <th align="right" style="padding:8px 10px;">Short Δ MoM</th>
            <th align="right" style="padding:8px 10px;">Insider net 6m</th>
          </tr>
          {% for sc in signal_rows %}{% set s = sc.signals %}
          <tr style="background-color:{{ '#ffffff' if loop.index is odd else '#f2f5f8' }};border-bottom:1px solid #dde3e9;">
            <td style="padding:7px 10px;font-weight:bold;">{{ sc.ticker }}</td>
            <td align="center" style="padding:7px 10px;">{% if s.eps_rev_up_30d is not none or s.eps_rev_down_30d is not none %}<span style="color:#1a7f37;">▲{{ s.eps_rev_up_30d if s.eps_rev_up_30d is not none else "?" }}</span>&nbsp;/&nbsp;<span style="color:#c0392b;">▼{{ s.eps_rev_down_30d if s.eps_rev_down_30d is not none else "?" }}</span>{% else %}n/a{% endif %}</td>
            <td align="center" style="padding:7px 10px;">{% if s.rec_bullish is not none %}{{ s.rec_bullish }} / {{ s.rec_neutral if s.rec_neutral is not none else "?" }} / {{ s.rec_bearish if s.rec_bearish is not none else "?" }}{% if s.rec_bullish_prior is not none and s.rec_bullish != s.rec_bullish_prior %} <span style="font-size:11px;color:{{ '#1a7f37' if s.rec_bullish > s.rec_bullish_prior else '#c0392b' }};">({{ s.rec_bullish_prior }}→{{ s.rec_bullish }})</span>{% endif %}{% else %}n/a{% endif %}</td>
            <td align="right" style="padding:7px 10px;">{{ s.short_pct_float|pct }}</td>
            <td align="right" style="padding:7px 10px;">{{ short_change_mom(s.shares_short, s.shares_short_prior)|spct }}</td>
            <td align="right" style="padding:7px 10px;color:{{ '#1a7f37' if s.insider_net_shares_6m and s.insider_net_shares_6m > 0 else '#c0392b' if s.insider_net_shares_6m and s.insider_net_shares_6m < 0 else '#33404d' }};">{{ s.insider_net_shares_6m|shares }}</td>
          </tr>
          {% endfor %}
        </table>
      </td></tr>
      {% endif %}
      {% if tech_only %}
      <tr><td style="padding:12px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">Technicals only <span style="font-size:12px;font-weight:normal;color:#66727f;">(not tagged r40, so no fundamentals scorecard)</span></td></tr>
      <tr><td style="padding:0 24px 12px;">
        <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:13px;">
          <tr style="background-color:#33404d;color:#ffffff;">
            <th align="left" style="padding:8px 10px;">Ticker</th>
            <th align="right" style="padding:8px 10px;">T score</th>
            <th align="left" style="padding:8px 10px;">Trend</th>
            <th align="right" style="padding:8px 10px;">RSI</th>
            <th align="right" style="padding:8px 10px;">RS 3m</th>
            <th align="right" style="padding:8px 10px;">vs 52w high</th>
          </tr>
          {% for row in tech_only %}
          <tr style="background-color:{{ '#ffffff' if loop.index is odd else '#f2f5f8' }};border-bottom:1px solid #dde3e9;">
            <td style="padding:7px 10px;font-weight:bold;">{{ row.ticker }}</td>
            <td align="right" style="padding:7px 10px;">{{ row.t_score|score }}</td>
            <td style="padding:7px 10px;white-space:nowrap;">{{ trend_arrows.get(row.tech.trend_state, "n/a") }}{% if spark_src.get(row.ticker) %}<br><img src="{{ spark_src[row.ticker] }}" width="120" height="30" alt="1y price" style="display:block;border:0;">{% endif %}</td>
            <td align="right" style="padding:7px 10px;">{{ "%.0f"|format(row.tech.rsi14) if row.tech.rsi14 is not none else "n/a" }}</td>
            <td align="right" style="padding:7px 10px;">{{ row.tech.rel_strength_3m|pct }}</td>
            <td align="right" style="padding:7px 10px;">{{ row.tech.dist_52w_high|pct }}</td>
          </tr>
          {% endfor %}
        </table>
      </td></tr>
      {% endif %}
      {% if bench_rows %}
      <tr><td style="padding:12px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#4a5a6a;">Bench (unranked)</td></tr>
      <tr><td style="padding:0 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#66727f;">
        Reserve swap candidates, scored on the same basis for comparison only. They are not ranked, not part of the watchlist median, and never appear above: comparison references, not recommendations. Between-quarter signals are not fetched for bench names, so they have no rows in the signals table above.
      </td></tr>
      <tr><td style="padding:0 24px 12px;">
        {{ scorecard_table(bench_rows) }}
      </td></tr>
      {% endif %}
      {% if unscored %}
      <tr><td style="padding:12px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">Not scored</td></tr>
      <tr><td style="padding:0 24px 12px;">
        <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:13px;">
          {% for sc in unscored %}
          <tr style="border-bottom:1px solid #dde3e9;">
            <td style="padding:7px 10px;font-weight:bold;width:80px;">{{ sc.ticker }}</td>
            <td style="padding:7px 10px;color:#8a6d00;">{{ flag_labels(sc)|join(" · ") or "insufficient data" }}</td>
          </tr>
          {% endfor %}
        </table>
      </td></tr>
      {% endif %}
      {% if deep %}
      <tr><td style="padding:12px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">Deep dive: full metric grid</td></tr>
      <tr><td style="padding:0 24px 12px;">
        <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:12px;">
          <tr style="background-color:#33404d;color:#ffffff;">
            <th align="left" style="padding:6px 8px;">Ticker</th>
            <th align="right" style="padding:6px 8px;">Rule of X</th>
            <th align="right" style="padding:6px 8px;">R40 trend</th>
            <th align="right" style="padding:6px 8px;">Op mgn</th>
            <th align="right" style="padding:6px 8px;">Dilution</th>
            <th align="right" style="padding:6px 8px;">SBC int.</th>
            <th align="right" style="padding:6px 8px;">EV/Rev</th>
            <th align="right" style="padding:6px 8px;">FCF yield</th>
            <th align="right" style="padding:6px 8px;">RSI</th>
            <th align="right" style="padding:6px 8px;">RS 3m</th>
            <th align="right" style="padding:6px 8px;">Vol ratio</th>
          </tr>
          {% for sc in all_scored %}
          <tr style="background-color:{{ '#ffffff' if loop.index is odd else '#f2f5f8' }};border-bottom:1px solid #dde3e9;">
            <td style="padding:5px 8px;font-weight:bold;">{{ sc.ticker }}</td>
            <td align="right" style="padding:5px 8px;">{{ sc.rule_of_x|pts }}</td>
            <td align="right" style="padding:5px 8px;">{{ sc.r40_trend|pts }}</td>
            <td align="right" style="padding:5px 8px;">{{ sc.op_margin|pct }}</td>
            <td align="right" style="padding:5px 8px;">{{ sc.dilution|pct }}</td>
            <td align="right" style="padding:5px 8px;">{{ sc.sbc_intensity|pct }}</td>
            <td align="right" style="padding:5px 8px;">{{ sc.ev_revenue|mult }}</td>
            <td align="right" style="padding:5px 8px;">{{ sc.fcf_yield|pct }}</td>
            <td align="right" style="padding:5px 8px;">{{ "%.0f"|format(sc.tech.rsi14) if sc.tech and sc.tech.rsi14 is not none else "n/a" }}</td>
            <td align="right" style="padding:5px 8px;">{{ sc.tech.rel_strength_3m|pct if sc.tech else "n/a" }}</td>
            <td align="right" style="padding:5px 8px;">{{ "%.1f×"|format(sc.tech.vol_ratio) if sc.tech and sc.tech.vol_ratio is not none else "n/a" }}</td>
          </tr>
          {% endfor %}
        </table>
      </td></tr>
      {% endif %}
      <tr><td style="padding:14px 24px 4px;border-top:1px solid #d8dee5;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:bold;color:#1f2d3d;">How to read this report</td></tr>
      <tr><td style="padding:2px 24px 12px;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#55606c;line-height:1.6;">
        Each row is one stock's quality check: did revenue growth plus profitability clear the &ldquo;Rule of 40&rdquo; bar?
        Rows are ranked by how many R40 variants clear 40 (those cells are shown <b>bold</b>; more bold cells, higher rank), then by Comp. The three variants use the same growth number but
        different profit margins: when they agree, the quality is real; when only R40&nbsp;FCF passes, stock comp is usually doing the heavy lifting.
        <br><br>
        <b>R40 (Rule of 40)</b>: revenue growth % + profit margin %; &ge; 40 points suggests a healthy growth/profitability balance.<br>
        <b>FCF</b>: free cash flow, meaning operating cash flow minus capital expenditure. <b>FCF mgn</b> is FCF as a % of revenue.<br>
        <b>EBITDA</b>: earnings before interest, taxes, depreciation &amp; amortization; the stricter accounting-basis margin.<br>
        <b>SBC</b>: stock-based compensation. The SBC-adj variant treats it as a cash cost, the &ldquo;honest&rdquo; R40.<br>
        <b>Growth</b>: trailing-twelve-month revenue vs a year earlier (fiscal-year based when flagged &ldquo;Growth from annual&rdquo;).<br>
        <b>Comp</b>: the ranking number, a 0 to 100 composite blending <b>F</b> and <b>T</b> below. Fundamentals say <i>what's</i> good; technicals say <i>how it's trading now</i>.<br>
        <b>F</b>: fundamental score, driven by R40&nbsp;FCF, with bonuses for passing more variants and an improving trend, penalties for dilution and heavy SBC.<br>
        <b>T</b>: technical score, from trend state, 3-month strength vs SPY, recent crosses, and distance from the 52-week high.<br>
        <b>Trend</b>: &uarr; price above both the 50- and 200-day averages, &darr; below both, &rarr; in between; the sparkline is the 1-year price path (green = up on the year).<br>
        <b>Valuation</b>: price label only, never part of Comp: <i>cheap</i> (FCF yield &gt; 4%), <i>fair</i>, or <i>priced-for-perfection</i> (&gt; 12&times; revenue and &lt; 1% FCF yield).<br>
        <b>Flags</b>: caveats on data quality (stale/short history) or earnings quality (dilution, high SBC, SBC-inflated R40).<br>
        <b>RSI</b>: 14-day relative strength index, a 0 to 100 momentum gauge: &gt; 70 overbought, &lt; 30 oversold.<br>
        <b>RS 3m</b>: 3-month return relative to SPY; positive means beating the market, negative means lagging it.<br>
        <b>Golden / death cross</b>: the 50-day average crossing above (📈 golden, bullish) or below (📉 death, bearish) the 200-day average within the last 10 sessions; classic trend-shift markers.<br>
        <b>EPS</b>: earnings per share, quarterly profit divided by share count; the number analysts publish estimates for.<br>
        <b>Est. revisions 30d</b>: how many analysts raised (▲) vs cut (▼) current-quarter EPS estimates in the last 30 days; the freshest fundamental tell between earnings reports.<br>
        <b>Recs (B/H/S)</b>: analyst ratings this month: buy-or-better / hold / sell-or-worse, with last month's buy count in parentheses when it changed.<br>
        <b>Short % float / Short &Delta; MoM</b>: shares sold short (bets the price falls) as % of float, the shares actually available to trade; &gt; 10% = heavily shorted. &Delta; MoM is the month-over-month change in shares short, per FINRA (the US brokerage regulator, which publishes short-interest data twice monthly).<br>
        <b>Insider net 6m</b>: shares bought minus sold by the company's own officers &amp; directors over 6 months; net buying is rare and notable, some selling is normal.{% if change_set %}<br>
        <b>What changed today</b>: every move since the prior run that cleared a reporting threshold (score/rank moves, flag changes, trend shifts, new crosses, estimate and short-interest swings); ▲ improving, ▼ worsening. A quiet line means nothing cleared a threshold, which is itself information.{% endif %}{% if deterioration %}<br>
        <b>Deterioration watch</b>: names showing several negative signals at once (score drops over one run and the week window, deep R40 trend decline, technical breakdown, estimate cuts, worsening short interest); the &ldquo;Why&rdquo; column lists each triggered signal.{% endif %}{% if news_sections %}<br>
        <b>What mattered today</b>: recent headlines from your configured feeds, matched to watchlist names by ticker or company name; each labeled block is the same news written in a different configured voice.{% endif %}{% if bench_rows %}<br>
        <b>Bench (unranked)</b>: reserve swap candidates, scored the same way as the watchlist so a rotation decision compares like with like. They are excluded from every ranking, the watchlist median, change detection and the alerts above, and carry no recommendation.{% endif %}
        {% if deep %}
        <br><br><u>Deep-dive grid</u><br>
        <b>Rule of X</b>: 2 &times; growth + FCF margin: like R40 but growth counts double; target &ge; 50.<br>
        <b>R40 trend</b>: change in R40&nbsp;FCF vs one year ago, in points; positive = improving trajectory, &lt; &minus;10 is a weak-list trigger.<br>
        <b>Op mgn</b>: operating income as % of TTM revenue (classic accounting profitability).<br>
        <b>Dilution</b>: 1-year growth in diluted share count; your ownership shrinks by this much per year, &gt; 3% is flagged.<br>
        <b>SBC int.</b>: stock-based compensation as % of TTM revenue; &gt; 15% is flagged.<br>
        <b>EV/Rev</b>: enterprise value (market cap + debt &minus; cash) &divide; TTM revenue; the size-adjusted price tag.<br>
        <b>FCF yield</b>: TTM free cash flow &divide; market cap; the cash return you'd earn at today's price (higher = cheaper).<br>
        <b>Vol ratio</b>: 20-day vs 100-day average trading volume; &gt; 1.5&times; = unusual activity.
