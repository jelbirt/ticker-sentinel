{% macro scorecard_table(rows) -%}
<table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:13px;">
  <tr style="background-color:#1f2d3d;color:#ffffff;">
    <th align="left" style="padding:8px 10px;">Ticker</th>
    <th align="right" style="padding:8px 10px;">Score</th>
    <th align="right" style="padding:8px 10px;">R40 FCF</th>
    <th align="right" style="padding:8px 10px;">R40 EBITDA</th>
    <th align="right" style="padding:8px 10px;">R40 SBC-adj</th>
    <th align="right" style="padding:8px 10px;">Growth</th>
    <th align="right" style="padding:8px 10px;">FCF mgn</th>
    <th align="left" style="padding:8px 10px;">Valuation</th>
    <th align="left" style="padding:8px 10px;">Flags</th>
  </tr>
  {% for sc in rows %}
  <tr style="background-color:{{ '#ffffff' if loop.index is odd else '#f2f5f8' }};border-bottom:1px solid #dde3e9;">
    <td style="padding:7px 10px;white-space:nowrap;"><span style="font-weight:bold;">{{ sc.ticker }}</span>{% if sc.company_name %}<br><span style="font-size:11px;color:#66727f;">{{ sc.company_name }}</span>{% endif %}</td>
    <td align="right" style="padding:7px 10px;">{{ sc.score|score }}</td>
    <td align="right" style="padding:7px 10px;font-weight:bold;">{{ sc.r40_fcf|pts }}</td>
    <td align="right" style="padding:7px 10px;">{{ sc.r40_ebitda|pts }}</td>
    <td align="right" style="padding:7px 10px;">{{ sc.r40_sbc_adj|pts }}</td>
    <td align="right" style="padding:7px 10px;">{{ sc.growth|pct }}</td>
    <td align="right" style="padding:7px 10px;">{{ sc.fcf_margin|pct }}</td>
    <td style="padding:7px 10px;">{{ sc.valuation or "—" }}</td>
    <td style="padding:7px 10px;color:#8a6d00;">{{ flag_labels(sc)|join(" · ") or "—" }}</td>
  </tr>
  {% endfor %}
</table>
{%- endmacro %}
<table cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#eef1f4;padding:0;margin:0;">
  <tr><td align="center" style="padding:20px 8px;">
    <table cellpadding="0" cellspacing="0" border="0" width="760" style="background-color:#ffffff;border:1px solid #d8dee5;">
      <tr><td style="padding:18px 24px;border-bottom:3px solid #1f2d3d;font-family:Arial,Helvetica,sans-serif;">
        <span style="font-size:20px;font-weight:bold;color:#1f2d3d;">Ticker Sentinel</span>
        <span style="font-size:13px;color:#66727f;">&nbsp;&nbsp;{{ report_date }} · {{ run_type }} run · {{ n_total }} tickers · watchlist median R40 (FCF): {{ median_r40 }}</span>
      </td></tr>
      {% if benchmark_line %}
      <tr><td style="padding:10px 24px;font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#33404d;background-color:#f7f9fb;">{{ benchmark_line }}</td></tr>
      {% endif %}
      {% if notes %}
      <tr><td style="padding:10px 24px;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:#8a6d00;background-color:#fff8e1;">
        <b>Data notes:</b>
        {% for note in notes %}<br>• {{ note }}{% endfor %}
      </td></tr>
      {% endif %}
      <tr><td style="padding:18px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">Strongest</td></tr>
      <tr><td style="padding:0 24px 12px;">
        {% if strongest %}{{ scorecard_table(strongest) }}{% else %}<span style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#66727f;">No scorable tickers this run.</span>{% endif %}
      </td></tr>
      <tr><td style="padding:12px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">Weakest</td></tr>
      <tr><td style="padding:0 24px 12px;">
        {% if weakest %}{{ scorecard_table(weakest) }}{% else %}<span style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:#66727f;">Watchlist smaller than top-N — every scored name already appears above.</span>{% endif %}
      </td></tr>
      {% if unscored %}
      <tr><td style="padding:12px 24px 6px;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;color:#1f2d3d;">Not scored</td></tr>
      <tr><td style="padding:0 24px 12px;">
        <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;font-family:Arial,Helvetica,sans-serif;font-size:13px;">
          {% for sc in unscored %}
          <tr style="border-bottom:1px solid #dde3e9;">
            <td style="padding:7px 10px;font-weight:bold;width:80px;">{{ sc.ticker }}</td>
            <td style="padding:7px 10px;color:#8a6d00;">{{ flag_labels(sc)|join(" · ") or "insufficient data" }}</td>
          </tr>
          {% endfor %}
        </table>
      </td></tr>
      {% endif %}
      <tr><td style="padding:14px 24px 4px;border-top:1px solid #d8dee5;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:bold;color:#1f2d3d;">How to read this report</td></tr>
      <tr><td style="padding:2px 24px 12px;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#55606c;line-height:1.6;">
        Each row is one stock's quality check: did revenue growth plus profitability clear the &ldquo;Rule of 40&rdquo; bar?
        Rows are ranked by how many R40 variants clear 40, then by Score. The three variants use the same growth number but
        different profit margins &mdash; when they agree, the quality is real; when only R40&nbsp;FCF passes, stock comp is usually doing the heavy lifting.
        <br><br>
        <b>R40 (Rule of 40)</b> &mdash; revenue growth % + profit margin %; &ge; 40 points suggests a healthy growth/profitability balance.<br>
        <b>FCF</b> &mdash; free cash flow: operating cash flow minus capital expenditure. <b>FCF mgn</b> is FCF as a % of revenue.<br>
        <b>EBITDA</b> &mdash; earnings before interest, taxes, depreciation &amp; amortization; the stricter accounting-basis margin.<br>
        <b>SBC</b> &mdash; stock-based compensation. The SBC-adj variant treats it as a cash cost &mdash; the &ldquo;honest&rdquo; R40.<br>
        <b>Growth</b> &mdash; trailing-twelve-month revenue vs a year earlier (fiscal-year based when flagged &ldquo;Growth from annual&rdquo;).<br>
        <b>Score</b> &mdash; 0&ndash;100 fundamental score: driven by R40&nbsp;FCF with bonuses for breadth and improving trend, minus penalties for dilution and heavy SBC.<br>
        <b>Valuation</b> &mdash; price label only, never part of Score: <i>cheap</i> (FCF yield &gt; 4%), <i>fair</i>, or <i>priced-for-perfection</i> (&gt; 12&times; revenue and &lt; 1% FCF yield).<br>
        <b>Flags</b> &mdash; caveats on data quality (stale/short history) or earnings quality (dilution, high SBC, SBC-inflated R40).
      </td></tr>
      <tr><td style="padding:10px 24px 16px;font-family:Arial,Helvetica,sans-serif;font-size:11px;color:#8a94a0;">
        Personal research heuristics — <b>not financial advice</b>. Generated by ticker-sentinel.
      </td></tr>
    </table>
  </td></tr>
</table>
