# secrets & local env — never commit
.env
.env.*

# run outputs
reports/

# per-run fallback snapshots — rewritten every run; versioning them would
# make the CI cache-commit step churn daily instead of weekly
data/cache/*.signals.json

# python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
build/
dist/
